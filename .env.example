# Environment Variables for Photo Gallery Application

# =============================================================================
# Admin Access Control
# =============================================================================
# Enable/disable admin dashboard access
# Set to 'true' to allow access to /admin routes
# When disabled, admin routes redirect to home page
NEXT_PUBLIC_ADMIN_ENABLED=false

# =============================================================================
# Rate Limiting (Optional - uses in-memory fallback if not set)
# =============================================================================
# Upstash Redis configuration for production rate limiting
# Sign up at https://upstash.com/ and create a Redis database
# Without these, the app uses an in-memory rate limiter (not suitable for multi-instance)

# UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-secret-token

# =============================================================================
# Future: Authentication (Not yet implemented)
# =============================================================================
# These would be needed when authentication is added
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key
# DATABASE_URL=postgresql://...
